[Unit]
Description=AMG Shift Central gunicorn
After=network.target

[Service]
# The app runs as its own unprivileged user, never root. A bug that let a
# request run code would otherwise hand over the whole VPS, including
# cloudflared's tunnel credentials, which would let an attacker sit in the
# middle of every user's session. As the shift-central user it can reach the
# app's own data and nothing else: not the GP rota's or Practice HR's, which
# run beside it as users of their own.
#
#   useradd --system --home-dir /var/lib/shift-central --no-create-home \
#           --shell /usr/sbin/nologin shift-central
User=shift-central
Group=shift-central

# The code lives in /srv/shift-central, owned by root and read-only to the
# shift-central user, so the app cannot rewrite itself. Its data lives in
# /var/lib/shift-central: systemd creates that as StateDirectory, owned by
# shift-central and closed to everyone else, and DB_PATH in
# /etc/shift-central.env points the database there. SQLite needs to write the
# directory its database sits in, which is why the two are apart.
WorkingDirectory=/srv/shift-central
StateDirectory=shift-central
StateDirectoryMode=0700
UMask=0077

# Secrets go in an environment file, not in Environment= lines. Unit files
# under /etc/systemd/system are world-readable by default, so a SECRET_KEY
# written here is readable by every local account, and with that key an
# attacker can forge a session cookie for any user, including an all-teams
# manager. systemd reads the file as root before it drops to the
# shift-central user, so it stays root-only. Create it once:
#
#   umask 077
#   /srv/shift-central/.venv/bin/python -c \
#     'from django.core.management.utils import get_random_secret_key as k; \
#      print("SECRET_KEY=" + k())' > /etc/shift-central.env
#   chmod 600 /etc/shift-central.env
#
# and add the rest of the settings to it:
#
#   DEBUG=0
#   DB_PATH=/var/lib/shift-central/db.sqlite3
#   ALLOWED_HOSTS=shifts.example.org
#   CSRF_TRUSTED_ORIGINS=https://shifts.example.org
#   PRACTICE_HR_URL=https://hr.example.org    # Practice HR: sign-in and the people feed
#   HR_API_TOKEN=…                # one of Practice HR's HR_API_TOKENS; hr_sync sends it
#   OIDC_RP_CLIENT_ID=…           # both printed once by Practice HR's
#   OIDC_RP_CLIENT_SECRET=…       #   register_oidc_client --name shift-central
#
# and, once the app sends email (nothing in this release does), the mail
# relay: EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD,
# EMAIL_USE_TLS (on by default) and DEFAULT_FROM_EMAIL.
#
# A value takes the whole line: an env file has no comment syntax after one,
# so the notes after the values above stay out of the real file. DEBUG
# defaults to 0 in config/settings.py, so omitting it is safe, but set it
# explicitly so the file states the intent.
EnvironmentFile=/etc/shift-central.env

# Bound to loopback on purpose: the Cloudflare tunnel is the only way in.
# settings.py trusts X-Forwarded-Proto to decide a request is HTTPS, which is
# only sound while nothing can reach gunicorn directly and set that header
# itself. Do not change this to 0.0.0.0. The GP rota is on 8321 and Practice
# HR on 8322, so this is the next free port.
ExecStart=/srv/shift-central/.venv/bin/gunicorn config.wsgi --bind 127.0.0.1:8323 --workers 2
Restart=always

# The sandbox. Everything outside /var/lib/shift-central is read-only, /home
# and /root are hidden, /tmp is private, and the process can gain no
# privileges or capabilities, load no kernel modules, change no kernel
# settings, and open no sockets but IP and Unix ones. The same block is in
# every shift-central unit; `systemd-analyze security shift-central` scores
# it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
