[Unit]
Description=Nightly Shift Central SQLite backup

[Service]
Type=oneshot
# As the shift-central user, not root. The copies are the app's own data, so
# they belong with it in /var/lib/shift-central, closed to everyone else; and
# a root sqlite3 opening a WAL database can leave -wal/-shm files the app
# cannot then open. The same user, directories and sandbox as the web
# service; see gunicorn.service for why each is there.
User=shift-central
Group=shift-central
StateDirectory=shift-central
StateDirectoryMode=0700
UMask=0077
ExecStart=/srv/shift-central/deploy/backup.sh

# Sandbox: identical in every shift-central unit (tests/test_deploy_units.py).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
