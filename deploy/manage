#!/bin/sh
# Run a management command the way the services run it: as the shift-central
# user, with the settings in /etc/shift-central.env, in the Shift Central state
# directory. Run it as root.
#
#   /srv/shift-central/deploy/manage migrate
#   /srv/shift-central/deploy/manage check --deploy
#   /srv/shift-central/deploy/manage createsuperuser
#   /srv/shift-central/deploy/manage hr_sync
#
# systemd reads the settings file, exactly as it does for the services. The
# shell cannot: `. /etc/shift-central.env` fails on a SECRET_KEY holding ( or
# $ or &, which Django's generated keys do.
#
# Why not plain `python manage.py` as root: the database is in WAL mode, and a
# root process that opens it can leave root-owned db.sqlite3-wal/-shm files
# (or, on a first migrate, a root-owned database) that the app then cannot
# open. The exceptions are collectstatic, which writes into the code tree,
# root's and read-only to the app, so it runs as root, world-readable; and
# vapid_keys, which writes the push key into /etc, where the app's user cannot
# write and the file's group has to be set. Neither opens the database.
set -eu
if [ "$(id -u)" != 0 ]; then
    echo "deploy/manage: run as root; it runs the command as the shift-central user" >&2
    exit 1
fi
code="$(cd "$(dirname "$0")/.." && pwd)"
if [ -t 0 ]; then io=--pty; else io=--pipe; fi
if [ "${1:-}" = collectstatic ] || [ "${1:-}" = vapid_keys ]; then
    as_whom="-p UMask=0022"
else
    as_whom="--uid=shift-central --gid=shift-central -p StateDirectory=shift-central -p StateDirectoryMode=0700 -p UMask=0077 -E HOME=/var/lib/shift-central"
fi
# shellcheck disable=SC2086  # $as_whom is a list of options
exec systemd-run --quiet --collect --wait "$io" $as_whom \
    -p EnvironmentFile=/etc/shift-central.env -p WorkingDirectory="$code" \
    "$code/.venv/bin/python" manage.py "$@"
